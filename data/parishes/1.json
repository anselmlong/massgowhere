 "info": {
  "devotions": [
   "Block Rosary: 5-7 Oct at 8.00pm at Blk 94, #03-758 Commonwealth Drive. Host: Amelia Paulete. There will be no Block Rosary on 12-14 Oct.",
   "During October, the Rosary is prayed at 6.00pm from Monday to Friday, right before the 6.30pm Mass at the main church. All are welcome to join."
  ],
  "good_to_know": [
   "Infant Baptism: every 2nd Sunday of the month at the 5.30pm Mass. For the next baptism schedule for children, contact the Parish Office.",
   "Anointing of the Sick: please make an appointment with the Secretariat for a priest to minister.",
   "Holy Matrimony: couples must inform the Priest at least 6 months before booking the Church for the Wedding Mass/Service.",
   "Adult Baptism or Confirmation: contact rcia.bsc@gmail.com for more information."
  ]
 },
