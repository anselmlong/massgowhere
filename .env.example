OPENROUTER_API_KEY=
# optional: comma-separated models that vote (default deepseek/deepseek-v4.1-flash)
# OPENROUTER_MODELS=
# OneMap account (routing); also set these in the Vercel project env
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
